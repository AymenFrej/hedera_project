HEDERA_NETWORK=testnet
# Account id from https://portal.hedera.com (testnet). Leave blank to keep the mock gateway.
HEDERA_OPERATOR_ID=
# The portal shows several encodings; the HEX one (with or without 0x) works, so does DER.
HEDERA_OPERATOR_PRIVATE_KEY=
# Key algorithm chosen when creating the account: ECDSA or ED25519.
HEDERA_KEY_TYPE=ECDSA
# Leave blank to create an HCS topic on first start, then pin the id here to reuse it.
# Topics are created without an admin key (nobody can delete the trail) and with a submit key
# (only this platform can append). Both are permanent, so a topic created differently cannot be
# fixed afterwards - create a new one instead. The app checks this at startup and warns.
HEDERA_AUDIT_TOPIC_ID=
HEDERA_ACCOUNT_KEY_ENCRYPTION_SECRET=replace-with-a-long-random-secret
# Verification reads go through the Mirror Node REST API, never through the SDK.
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Payments demo: a fixed-supply HTS token (0 decimals, treasury = operator) and a recipient
# already associated with it. Create both once with: cd backend && ./mvnw test -Dtest=PaymentDemoSetup
PAYMENT_DEMO_TOKEN_ID=
PAYMENT_DEMO_RECIPIENT_ID=

# Payment agent sentence box ("Pay Zied 5 HBAR"): which model reads the sentence.
#   claude - paid, key from https://console.anthropic.com (ANTHROPIC_API_KEY)
#   gemini - free tier, key from https://aistudio.google.com (GEMINI_API_KEY), no card needed
#   ollama - free and local: install https://ollama.com, then run: ollama pull qwen2.5:3b
# Leave blank to use Claude when its key is set, otherwise off; the manual request form keeps working.
PAYMENT_AI_PROVIDER=
ANTHROPIC_API_KEY=
PAYMENT_AI_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=hedera_agents
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

BACKEND_PORT=8080
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
